GEMINI_API_KEY=
# Prefer Gemini 3.x — avoid gemini-2.5-flash / gemini-2.0-flash on new free keys
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-latest
GEMINI_RETRY_ATTEMPTS=1
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=2048
GEMINI_MAX_OUTPUT_TOKENS=4096
DWH_PROFILE=olist
DWH_SQLITE_PATH=Data/olist_dwh.sqlite
MCP_ENDPOINT=http://localhost:8081/api/mcp
MCP_TIMEOUT_SECONDS=300
MCP_LOCAL_FALLBACK=1
DWH_AGGREGATE_GROUP_CAP=50000
APP_DEBUG=1
