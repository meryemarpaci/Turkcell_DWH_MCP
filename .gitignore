__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.env
.DS_Store
Thumbs.db

# Editor / IDE local config (not required to run the product)
.cursor/

# Local runtime / secrets
storage/sessions/*
!storage/sessions/.gitkeep
storage/runtime/*
!storage/runtime/.gitkeep
storage/registry/*
!storage/registry/.gitkeep
php/cache/*
php/cacert.pem

# Large local datasets (build SQLite via scripts/build_sqlite_dwh.py)
Data/*.csv
Data/*.sqlite
Data/*.db
!Data/.gitkeep
!Data/README.md

# Node / misc
node_modules/
*.log
*.swp
*.swo
