{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DWHQueryPlan",
  "type": "object",
  "required": ["intent", "metrics", "tables", "joins", "filters", "grain", "limits"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["aggregate", "list", "compare", "trend"]
    },
    "metrics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dimensions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tables": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "joins": {
      "type": "array",
      "items": { "type": "string" }
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["column", "op", "source_table"],
        "properties": {
          "column": { "type": "string" },
          "op": { "type": "string" },
          "value": {},
          "source_table": { "type": "string" }
        }
      }
    },
    "time_range": {
      "type": "object",
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" },
        "column": { "type": "string" },
        "source_table": { "type": "string" }
      }
    },
    "grain": {
      "type": "string",
      "enum": ["order", "order_item", "payment", "review", "day"]
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_rows": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
